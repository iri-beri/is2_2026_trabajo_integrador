<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-2xl border border-gray-200">

        <h1 class="text-3xl font-extrabold text-center text-gray-900 mb-2">
            Panel del Estudiante
        </h1>

        {{#username}}
        <p class="text-xl text-center text-gray-700 mb-8">
            Bienvenido, <span class="font-bold text-green-600">{{username}}</span>
        </p>
        {{/username}}

        <!-- Placeholder de funcionalidades -->
        <div class="bg-green-50 border border-green-300 p-6 rounded-lg text-center shadow-md mb-6">
            <h2 class="text-xl font-semibold text-green-800 mb-2">Mis Inscripciones</h2>
            <p class="text-gray-500 text-sm">Próximamente disponible.</p>
        </div>

        <div class="bg-green-50 border border-green-300 p-6 rounded-lg text-center shadow-md mb-8">
            <h2 class="text-xl font-semibold text-green-800 mb-2">Mis Exámenes</h2>
            <p class="text-gray-500 text-sm">Próximamente disponible.</p>
        </div>

        <!-- Cerrar sesión -->
        <div class="text-center mt-4">
            <form action="/logout" method="post">
                <button type="submit"
                        class="inline-block bg-red-600 text-white py-2 px-6 rounded-full font-medium hover:bg-red-700 transition duration-300 shadow-md">
                    Cerrar Sesión
                </button>
            </form>
        </div>

    </div>
</body>
</html>
