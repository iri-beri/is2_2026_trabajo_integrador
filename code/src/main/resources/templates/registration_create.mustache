<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscribir Alumno a Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md border border-gray-200">

        <div class="text-center mb-6">
            <p class="text-4xl mb-2">📝</p>
            <h1 class="text-2xl font-extrabold text-gray-900">
                Inscribir Alumno a Materia
            </h1>
            <p class="text-gray-500 text-sm mt-1">
                Seleccioná una materia para completar la inscripción.
            </p>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-6">
            <h2 class="text-sm font-bold text-purple-700 uppercase tracking-wide mb-2">
                Alumno seleccionado
            </h2>

            <p class="text-gray-800 font-medium">
                {{studentSurname}}, {{studentName}}
            </p>

            <p class="text-gray-500 text-sm">
                DNI: {{studentDni}}
            </p>
        </div>

        {{#errorMessage}}
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-red-700 text-sm font-medium">
                {{errorMessage}}
            </p>
        </div>
        {{/errorMessage}}

        {{#hasAvailable}}
        <form method="post" action="/registration/new" class="space-y-5">

            <input type="hidden" name="student_dni" value="{{studentDni}}" />

            <div>
                <label for="subject_id"
                       class="block text-sm font-semibold text-gray-700 mb-2">
                    Materia
                </label>

                <select id="subject_id"
                        name="subject_id"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg
                               focus:ring-2 focus:ring-purple-500
                               focus:border-purple-500 outline-none transition
                               text-gray-700 bg-white">

                    <option value="" disabled selected>
                        — Seleccioná una materia —
                    </option>

                    {{#availableSubjects}}
                    <option value="{{id}}">
                        {{name}} (Cód. {{code}} · {{hours}}h)
                    </option>
                    {{/availableSubjects}}

                </select>
            </div>

            <button type="submit"
                    class="w-full bg-purple-600 text-white py-3 rounded-full
                           font-bold hover:bg-purple-700 transition duration-300 shadow">
                Inscribir Alumno
            </button>

        </form>
        {{/hasAvailable}}

        {{^hasAvailable}}
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
            <p class="text-amber-800 text-sm">
                El alumno ya está inscripto en todas las materias disponibles de su carrera.
            </p>
        </div>
        {{/hasAvailable}}

        <hr class="my-6 border-gray-200">

        <div class="text-center">
            <a href="/dashboard/admin"
               class="text-purple-600 hover:underline text-sm font-medium">
                ← Volver al Dashboard
            </a>
        </div>

    </div>

</body>
</html>