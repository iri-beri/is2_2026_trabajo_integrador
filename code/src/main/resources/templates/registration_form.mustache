<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Inscribir Alumno a Materia</title>
</head>
<body>

    <h1>Inscribir Alumno a Materia</h1>

    {{#errorMessage}}
        <p style="color: red;">{{errorMessage}}</p>
    {{/errorMessage}}

    <form action="/registration/new" method="post">

        <label for="dni">DNI del Alumno</label>
        <input type="text" id="dni" name="dni" required />

        <label for="subject_id">ID de la Materia</label>
        <input type="number" id="subject_id" name="subject_id" required />

        <button type="submit">Inscribir</button>

    </form>

</body>
</html>
