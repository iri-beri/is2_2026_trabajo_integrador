<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscripción Confirmada</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md border border-gray-200">

        <div class="text-center mb-6">
            <p class="text-4xl mb-2">📚</p>
            <h1 class="text-2xl font-extrabold text-gray-900">
                Inscripción Realizada
            </h1>
            <p class="text-gray-500 text-sm mt-1">
                El alumno fue inscripto correctamente a la materia.
            </p>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-lg p-4 mb-4">
            <h2 class="text-sm font-bold text-purple-700 uppercase tracking-wide mb-2">
                Alumno
            </h2>

            <p class="text-gray-800 font-medium">
                {{studentName}} {{studentSurname}}
            </p>

            <p class="text-gray-500 text-sm">
                ID: {{studentId}}
            </p>

            <p class="text-gray-500 text-sm">
                DNI: {{studentDni}}
            </p>

            <p class="text-gray-500 text-sm">
                Email: {{studentEmail}}
            </p>
        </div>

        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4">
            <h2 class="text-sm font-bold text-amber-700 uppercase tracking-wide mb-2">
                Materia
            </h2>

            <p class="text-gray-800 font-medium">
                {{subjectName}}
            </p>

            <p class="text-gray-500 text-sm">
                ID: {{subjectId}}
            </p>

            <p class="text-gray-500 text-sm">
                Código: {{subjectCode}}
            </p>

            <p class="text-gray-500 text-sm">
                Horas: {{subjectHours}}
            </p>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
            <h2 class="text-sm font-bold text-blue-700 uppercase tracking-wide mb-2">
                Información de la inscripción
            </h2>

            <p class="text-gray-700 text-sm">
                Fecha: <strong>{{date}}</strong>
            </p>
        </div>

        <div class="flex flex-col gap-3">
            <a href="/registration/create"
               class="w-full text-center bg-purple-600 text-white py-2 px-4 rounded-full font-bold hover:bg-purple-700 transition duration-300 shadow">
                Nueva Inscripción
            </a>

            <a href="/dashboard/admin"
               class="w-full text-center text-purple-600 hover:underline text-sm font-medium">
                ← Volver al Dashboard
            </a>
        </div>

    </div>

</body>
</html>