<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Materias — {{careerName}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-start justify-center min-h-screen p-6"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-4xl border border-gray-200 my-4">

        <!-- Encabezado -->
        <div class="mb-6">
            <p class="text-xs font-mono text-gray-400 uppercase tracking-widest mb-1">Carrera #{{careerCode}}</p>
            <h1 class="text-3xl font-extrabold text-gray-900">{{careerName}}</h1>
            <p class="text-gray-500 text-sm mt-1">Administrá las materias que pertenecen a esta carrera.</p>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <!-- ─── Materias asignadas ─────────────────────────────────── -->
        <div class="mb-8">
            <h2 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-full bg-amber-500"></span>
                Materias asignadas
            </h2>

            {{#hasAssigned}}
            <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
                <table class="w-full text-sm text-left text-gray-700">
                    <thead class="bg-amber-50 text-amber-800 font-semibold text-xs uppercase tracking-wide">
                        <tr>
                            <th class="px-5 py-3 w-20">Código</th>
                            <th class="px-5 py-3">Nombre</th>
                            <th class="px-5 py-3 w-24 text-center">Horas</th>
                            <th class="px-5 py-3 w-28 text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {{#assignedSubjects}}
                        <tr class="hover:bg-red-50 transition duration-150">
                            <td class="px-5 py-3 font-mono text-gray-400">{{code}}</td>
                            <td class="px-5 py-3 font-medium text-gray-900">{{name}}</td>
                            <td class="px-5 py-3 text-center text-gray-600">{{hours}}h</td>
                            <td class="px-5 py-3 text-center">
                                <form method="post"
                                      action="/careers/{{careerId}}/subjects/{{id}}/remove"
                                      onsubmit="return confirm('¿Quitar {{name}} de la carrera?');">
                                    <button type="submit"
                                            class="bg-red-100 text-red-700 py-1 px-3 rounded-full text-xs font-bold hover:bg-red-200 transition duration-200 border border-red-300">
                                        Quitar
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {{/assignedSubjects}}
                    </tbody>
                </table>
            </div>
            {{/hasAssigned}}

            {{^hasAssigned}}
            <div class="text-center py-8 text-gray-400 bg-gray-50 rounded-lg border border-dashed border-gray-300">
                <p class="text-3xl mb-2">📭</p>
                <p class="text-sm">Esta carrera no tiene materias asignadas todavía.</p>
            </div>
            {{/hasAssigned}}
        </div>

        <hr class="my-6 border-gray-200">

        <!-- ─── Agregar materia ────────────────────────────────────── -->
        <div>
            <h2 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-full bg-green-500"></span>
                Agregar materia
            </h2>

            {{#hasAvailable}}
            <form method="post" action="/careers/{{careerId}}/subjects/add"
                  class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">

                <select name="subject_id"
                        required
                        class="flex-1 px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm text-gray-700 bg-white">
                    <option value="" disabled selected>— Seleccioná una materia —</option>
                    {{#availableSubjects}}
                    <option value="{{id}}">{{name}} (Cód. {{code}} · {{hours}}h)</option>
                    {{/availableSubjects}}
                </select>

                <button type="submit"
                        class="bg-amber-600 text-white py-2 px-6 rounded-full font-bold text-sm hover:bg-amber-700 transition duration-300 shadow hover:scale-105 transform whitespace-nowrap">
                    + Agregar
                </button>
            </form>
            {{/hasAvailable}}

            {{^hasAvailable}}
            <div class="text-center py-8 text-gray-400 bg-gray-50 rounded-lg border border-dashed border-gray-300">
                <p class="text-3xl mb-2">✅</p>
                <p class="text-sm">Todas las materias disponibles ya están asignadas a esta carrera.</p>
            </div>
            {{/hasAvailable}}
        </div>

        <!-- ─── Navegación ────────────────────────────────────────── -->
        <div class="flex justify-between items-center mt-10 pt-6 border-t border-gray-100">
            <a href="/careers"
               class="text-amber-600 hover:underline text-sm font-medium">
                ← Volver a Carreras
            </a>
            <a href="/dashboard"
               class="text-gray-400 hover:underline text-sm">
                Dashboard
            </a>
        </div>

    </div>
</body>
</html>
