<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profesores Registrados</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4"
    style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-5xl border border-gray-200">

        <!-- Encabezado -->
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900">Profesores Registrados</h1>
            <a href="/dashboard/admin"
               class="inline-block bg-gray-200 text-gray-700 py-2 px-5 rounded-full font-medium hover:bg-gray-300 transition duration-300 shadow">
                ← Volver al Panel
            </a>
        </div>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <!-- Sin resultados -->
        {{^professors}}
        <div class="bg-indigo-50 border border-indigo-300 p-8 rounded-lg text-center shadow-md">
            <p class="text-indigo-700 text-lg font-medium">No hay profesores registrados aún.</p>
            <a href="/professor/create"
               class="inline-block mt-4 bg-indigo-600 text-white py-2 px-6 rounded-full font-bold shadow-lg hover:bg-indigo-700 transition duration-300 transform hover:scale-105">
                + Registrar Primer Profesor
            </a>
        </div>
        {{/professors}}

        <!-- Tabla de profesores -->
        {{#professors}}
        {{#first}}
        <div class="overflow-x-auto rounded-lg shadow-md border border-indigo-200">
            <table class="min-w-full text-sm text-gray-700">
                <thead>
                    <tr class="bg-indigo-600 text-white text-left">
                        <th class="py-3 px-4 font-semibold">Nombre</th>
                        <th class="py-3 px-4 font-semibold">Apellido</th>
                        <th class="py-3 px-4 font-semibold">DNI</th>
                        <th class="py-3 px-4 font-semibold">Cargo</th>
                        <th class="py-3 px-4 font-semibold">Email</th>
                        <th class="py-3 px-4 font-semibold">Celular</th>
                    </tr>
                </thead>
                <tbody>
        {{/first}}
                    <tr class="border-b border-indigo-100 hover:bg-indigo-50 transition duration-150">
                        <td class="py-3 px-4 font-medium">{{name}}</td>
                        <td class="py-3 px-4">{{surname}}</td>
                        <td class="py-3 px-4">{{dni}}</td>
                        <td class="py-3 px-4">{{position}}</td>
                        <td class="py-3 px-4">{{email}}</td>
                        <td class="py-3 px-4">{{cellphone}}</td>
                    </tr>
        {{#last}}
                </tbody>
            </table>
        </div>
        {{/last}}
        {{/professors}}

        <!-- Acciones inferiores -->
        <div class="flex justify-between items-center mt-8">
            <a href="/professor/create"
               class="inline-block bg-indigo-600 text-white py-2 px-6 rounded-full font-bold shadow-lg hover:bg-indigo-700 transition duration-300 transform hover:scale-105">
                + Registrar Nuevo Profesor
            </a>
            <a href="/logout"
               class="inline-block bg-red-600 text-white py-2 px-6 rounded-full font-medium hover:bg-red-700 transition duration-300 shadow-md">
                Cerrar Sesión
            </a>
        </div>

    </div>
</body>
</html>
