<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumnos de la Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

<div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-5xl border border-gray-200">

    <!-- Encabezado -->
    <div class="flex items-center justify-between mb-2">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Alumnos Inscriptos</h1>
            <p class="text-gray-500 mt-1 text-sm">
                <span class="font-semibold text-indigo-700">{{subjectName}}</span>
                &nbsp;·&nbsp; Código: <span class="font-mono">{{subjectCode}}</span>
            </p>
        </div>
        <a href="/professor/my-subjects"
           class="inline-block bg-gray-200 text-gray-700 py-2 px-5 rounded-full font-medium hover:bg-gray-300 transition duration-300 shadow">
            ← Volver a Mis Materias
        </a>
    </div>

    <hr class="my-6 border-indigo-100">

    {{#successMessage}}
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
        ✓ {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
        ✗ {{errorMessage}}
    </div>
    {{/errorMessage}}

    {{^students}}
    <div class="bg-indigo-50 border border-indigo-200 p-8 rounded-lg text-center shadow-sm">
        <p class="text-indigo-600 font-medium text-lg">No hay alumnos inscriptos en esta materia aún.</p>
    </div>
    {{/students}}

    {{#students}}
    {{#first}}
    <div class="space-y-4">
    {{/first}}

        <!-- Tarjeta por alumno -->
        <div class="border border-indigo-200 rounded-xl p-5 shadow-sm hover:shadow-md transition duration-200 bg-indigo-50">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <!-- Info del alumno -->
                <div>
                    <p class="font-bold text-gray-800 text-lg">{{name}} {{surname}}</p>
                    <p class="text-gray-500 text-sm">DNI: {{dni}} &nbsp;·&nbsp; Inscripto: {{enrollDate}}</p>
                    {{#hasGrade}}
                    <p class="mt-1 text-sm">
                        Nota actual:
                        <span class="font-bold {{#approved}}text-green-600{{/approved}}{{^approved}}text-red-500{{/approved}}">
                            {{grade}}
                        </span>
                        {{#description}}
                        &nbsp;·&nbsp; <span class="text-gray-500 italic">{{description}}</span>
                        {{/description}}
                        &nbsp;·&nbsp; <span class="text-gray-400 text-xs">{{gradeDate}}</span>
                    </p>
                    {{/hasGrade}}
                </div>

                <!-- Formulario de nota -->
                <form method="POST" action="/professor/subject/{{subjectId}}/grade"
                      class="flex flex-wrap gap-2 items-end">
                    <input type="hidden" name="studentId" value="{{studentId}}">

                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Nota (0–10)</label>
                        <input type="number" name="grade" min="0" max="10" step="0.5"
                               value="{{grade}}" placeholder="0–10" required
                               class="w-24 px-3 py-2 border border-indigo-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>

                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Observación (opcional)</label>
                        <input type="text" name="description" value="{{description}}"
                               placeholder="ej: parcial 1"
                               class="w-48 px-3 py-2 border border-indigo-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>

                    <button type="submit"
                            class="bg-indigo-600 text-white py-2 px-4 rounded-full text-sm font-semibold hover:bg-indigo-700 transition duration-200 shadow">
                        {{#hasGrade}}Actualizar{{/hasGrade}}{{^hasGrade}}Cargar Nota{{/hasGrade}}
                    </button>
                </form>

            </div>
        </div>

    {{#last}}
    </div>
    {{/last}}
    {{/students}}

    <div class="flex justify-end mt-8">
        <a href="/logout"
           class="inline-block bg-red-600 text-white py-2 px-6 rounded-full font-medium hover:bg-red-700 transition duration-300 shadow-md">
            Cerrar Sesión
        </a>
    </div>

</div>
</body>
</html>
