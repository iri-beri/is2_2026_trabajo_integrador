<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Configuración de Cuenta</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4"
        style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
        Configuración de Cuenta
    </h1>

    {{#successMessage}}
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        {{errorMessage}}
    </div>
    {{/errorMessage}}

    <form action="/settings/update" method="post" class="space-y-4">

        <!-- Información Personal -->
        <h2 class="text-xl font-semibold text-gray-700 mb-2">
            Información Personal
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Nombre
                </label>
                <input type="text"
                        name="name"
                        value="{{name}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Apellido
                </label>
                <input type="text"
                        name="surname"
                        value="{{surname}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Email
                </label>
                <input type="email"
                        name="email"
                        value="{{email}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Celular
                </label>
                <input type="text"
                        name="cellphone"
                        value="{{cellphone}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Fecha de Nacimiento
                </label>
                <input type="date"
                        name="birthdate"
                        value="{{birthdate}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
        </div>

        <!-- Profesor -->
        {{#professor}}

        <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-2 border-t border-gray-200 pt-4">
            Información Académica
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Título
                </label>
                <input type="text"
                        name="degree"
                        value="{{degree}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Universidad
                </label>
                <input type="text"
                        name="graduate_univ"
                        value="{{graduate_univ}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="md:col-span-2">
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Cargo
                </label>
                <input type="text"
                        name="position"
                        value="{{position}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

        </div>

        {{/professor}}

        <!-- Estudiante -->
        {{#student}}

        <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-2 border-t border-gray-200 pt-4">
            Información Estudiantil
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Lugar de nacimiento
                </label>
                <input type="text"
                        name="birthplace"
                        value="{{birthplace}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Residencia
                </label>
                <input type="text"
                        name="town_of_residence"
                        value="{{town_of_residence}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Contacto familiar
                </label>
                <input type="text"
                        name="contact_relative"
                        value="{{contact_relative}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Teléfono de contacto
                </label>
                <input type="text"
                        name="contact_cellphone"
                        value="{{contact_cellphone}}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

        </div>

        {{/student}}

        <!-- Botones -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4">

            <button type="submit"
                    class="flex-1 bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                Guardar Cambios
            </button>
        </div>
    </form>

    <hr class="my-8 border-gray-300">

    <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-2 border-t border-gray-200 pt-4">
        Cambiar contraseña
    </h2>

    <form action="/settings/password" method="post" class="space-y-4">
        <div class="space-y-4">
            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Contraseña actual
                </label>
                <input type="password"
                        name="currentPassword"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Contraseña nueva
                </label>
                <input type="password"
                        name="newPassword"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Confirma la contraseña nueva
                </label>
                <input type="password"
                        name="confirmPassword"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit"
                class="flex-1 bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            Cambiar Contraseña
            </button>

        <!-- Botones -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4">

            <button type="submit"
                    class="flex-1 bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                Guardar Cambios
            </button>
        </div>
    </form>

    <hr class="my-8 border-gray-300">

    <!-- Botones -->
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a href="/dashboard"
            class="flex-1 text-center bg-gray-600 text-white py-2 px-4 rounded-md hover:bg-gray-700">
            Volver al Dashboard
        </a>
    </div>
</div>

</body>
</html>
