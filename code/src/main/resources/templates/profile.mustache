<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Perfil</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4"
        style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">

        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
            Mi Perfil
        </h1>

        <!-- Mensajes -->
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <!-- Información Personal -->
        <h2 class="text-xl font-semibold text-gray-700 mb-4">
            Información Personal
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Nombre
                </label>
                <input type="text"
                        value="{{name}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Apellido
                </label>
                <input type="text"
                        value="{{surname}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    DNI
                </label>
                <input type="text"
                        value="{{dni}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Usuario
                </label>
                <input type="text"
                        value="{{username}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Email
                </label>
                <input type="text"
                        value="{{email}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Celular
                </label>
                <input type="text"
                        value="{{cellphone}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Fecha de Nacimiento
                </label>
                <input type="text"
                        value="{{birthdate}}"
                        disabled
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

        </div>

        <!-- Roles -->
        <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-4 border-t border-gray-200 pt-4">
            Privilegios del Usuario
        </h2>

        <div class="flex flex-wrap gap-3">

            {{#isAdmin}}
            <span class="bg-red-100 text-red-800 px-4 py-2 rounded-full text-sm font-semibold">
                Administrador
            </span>
            {{/isAdmin}}

            {{#isProfessor}}
            <span class="bg-indigo-100 text-indigo-800 px-4 py-2 rounded-full text-sm font-semibold">
                Profesor
            </span>
            {{/isProfessor}}

            {{#isStudent}}
            <span class="bg-green-100 text-green-800 px-4 py-2 rounded-full text-sm font-semibold">
                Estudiante
            </span>
            {{/isStudent}}

        </div>

        {{#professor}}

        <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-4 border-t border-gray-200 pt-4">
            Información Académica
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Título
                </label>

                <input type="text"
                    value="{{degree}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Universidad
                </label>

                <input type="text"
                    value="{{graduate_univ}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div class="md:col-span-2">
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Cargo
                </label>

                <input type="text"
                    value="{{position}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

        </div>

        {{/professor}}

        {{#student}}

        <h2 class="text-xl font-semibold text-gray-700 mt-8 mb-4 border-t border-gray-200 pt-4">
            Información Estudiantil
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Lugar de nacimiento
                </label>

                <input type="text"
                    value="{{birthplace}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Residencia
                </label>

                <input type="text"
                    value="{{town_of_residence}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Contacto familiar
                </label>

                <input type="text"
                    value="{{contact_relative}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

            <div>
                <label class="block text-gray-700 text-sm font-medium mb-1">
                    Teléfono de contacto
                </label>

                <input type="text"
                    value="{{contact_cellphone}}"
                    disabled
                    class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100">
            </div>

        </div>

        {{/student}}

        <!-- Acciones -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4">

            <a href="/settings"
                class="flex-1 text-center bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700">
                Editar Perfil
            </a>

            <a href="/dashboard"
                class="flex-1 text-center bg-gray-600 text-white py-2 px-4 rounded-md hover:bg-gray-700">
                Volver al Dashboard
            </a>

        </div>

    </div>

</body>
</html>