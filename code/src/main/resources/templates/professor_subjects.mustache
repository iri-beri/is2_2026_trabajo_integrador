<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Materias del Profesor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4"
    style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-5xl border border-gray-200">

        <!-- Encabezado -->
        <div class="flex items-center justify-between mb-2">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900">Materias del Profesor</h1>
                <p class="text-gray-500 mt-1 text-sm">
                    <span class="font-semibold text-indigo-700">{{professorName}} {{professorSurname}}</span>
                    &nbsp;·&nbsp; DNI: {{professorDni}}
                </p>
            </div>
            <a href="/admin/professors"
               class="inline-block bg-gray-200 text-gray-700 py-2 px-5 rounded-full font-medium hover:bg-gray-300 transition duration-300 shadow">
                ← Volver a Profesores
            </a>
        </div>

        <hr class="my-6 border-indigo-100">

        <!-- Mensajes flash -->
        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            ✓ {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            ✗ {{errorMessage}}
        </div>
        {{/errorMessage}}

        <!-- ============================================================ -->
        <!-- SECCIÓN: Materias asignadas                                   -->
        <!-- ============================================================ -->
        <h2 class="text-xl font-bold text-gray-800 mb-3">Materias asignadas</h2>

        {{^assignedSubjects}}
        <div class="bg-indigo-50 border border-indigo-200 p-5 rounded-lg text-center mb-8 shadow-sm">
            <p class="text-indigo-600 font-medium">Este profesor no tiene materias asignadas aún.</p>
        </div>
        {{/assignedSubjects}}

        {{#assignedSubjects}}
        {{#first}}
        <div class="overflow-x-auto rounded-lg shadow-md border border-indigo-200 mb-8">
            <table class="min-w-full text-sm text-gray-700">
                <thead>
                    <tr class="bg-indigo-600 text-white text-left">
                        <th class="py-3 px-4 font-semibold">Código</th>
                        <th class="py-3 px-4 font-semibold">Nombre</th>
                        <th class="py-3 px-4 font-semibold">Horas</th>
                        <th class="py-3 px-4 font-semibold">Programa</th>
                        <th class="py-3 px-4 font-semibold text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
        {{/first}}
                    <tr class="border-b border-indigo-100 hover:bg-indigo-50 transition duration-150">
                        <td class="py-3 px-4 font-mono text-indigo-700 font-semibold">{{code}}</td>
                        <td class="py-3 px-4 font-medium">{{name}}</td>
                        <td class="py-3 px-4">{{hours}} hs</td>
                        <td class="py-3 px-4 text-gray-500 truncate max-w-xs">{{courseSyllabus}}</td>
                        <td class="py-3 px-4 text-center">
                            <form method="POST" action="/admin/professor/{{professorId}}/subjects/remove"
                                  onsubmit="return confirm('¿Quitar esta materia del profesor?')">
                                <input type="hidden" name="subjectId" value="{{subjectId}}">
                                <button type="submit"
                                    class="bg-red-100 text-red-600 border border-red-300 py-1 px-3 rounded-full text-xs font-semibold hover:bg-red-200 transition duration-200">
                                    Quitar
                                </button>
                            </form>
                        </td>
                    </tr>
        {{#last}}
                </tbody>
            </table>
        </div>
        {{/last}}
        {{/assignedSubjects}}

        <!-- ============================================================ -->
        <!-- SECCIÓN: Agregar materia disponible                           -->
        <!-- ============================================================ -->
        <h2 class="text-xl font-bold text-gray-800 mb-3">Agregar materia</h2>

        {{^availableSubjects}}
        <div class="bg-gray-50 border border-gray-200 p-5 rounded-lg text-center shadow-sm">
            <p class="text-gray-500 font-medium">No hay materias disponibles para agregar.</p>
            <a href="/subject/create"
               class="inline-block mt-3 bg-indigo-600 text-white py-2 px-5 rounded-full text-sm font-bold shadow hover:bg-indigo-700 transition duration-300">
                + Crear nueva materia
            </a>
        </div>
        {{/availableSubjects}}

        {{#availableSubjects}}
        {{#first}}
        <div class="overflow-x-auto rounded-lg shadow-md border border-gray-200">
            <table class="min-w-full text-sm text-gray-700">
                <thead>
                    <tr class="bg-gray-100 text-gray-600 text-left">
                        <th class="py-3 px-4 font-semibold">Código</th>
                        <th class="py-3 px-4 font-semibold">Nombre</th>
                        <th class="py-3 px-4 font-semibold">Horas</th>
                        <th class="py-3 px-4 font-semibold text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
        {{/first}}
                    <tr class="border-b border-gray-100 hover:bg-gray-50 transition duration-150">
                        <td class="py-3 px-4 font-mono text-gray-600">{{code}}</td>
                        <td class="py-3 px-4 font-medium">{{name}}</td>
                        <td class="py-3 px-4">{{hours}} hs</td>
                        <td class="py-3 px-4 text-center">
                            <form method="POST" action="/admin/professor/{{professorId}}/subjects/add">
                                <input type="hidden" name="subjectId" value="{{subjectId}}">
                                <button type="submit"
                                    class="bg-indigo-100 text-indigo-700 border border-indigo-300 py-1 px-3 rounded-full text-xs font-semibold hover:bg-indigo-200 transition duration-200">
                                    + Agregar
                                </button>
                            </form>
                        </td>
                    </tr>
        {{#last}}
                </tbody>
            </table>
        </div>
        {{/last}}
        {{/availableSubjects}}

        <!-- Acciones inferiores -->
        <div class="flex justify-between items-center mt-8">
            <a href="/subject/create"
               class="inline-block bg-indigo-600 text-white py-2 px-6 rounded-full font-bold shadow-lg hover:bg-indigo-700 transition duration-300 transform hover:scale-105">
                + Crear nueva materia
            </a>
            <a href="/logout"
               class="inline-block bg-red-600 text-white py-2 px-6 rounded-full font-medium hover:bg-red-700 transition duration-300 shadow-md">
                Cerrar Sesión
            </a>
        </div>

    </div>
</body>
</html>
