<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>:root { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="flex items-center justify-center min-h-screen p-4"
      style="background: linear-gradient(135deg, #0d3f6e 0%, #1370a2 50%, #0f6e56 100%);">

<div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-4xl border border-gray-200">

    <!-- Encabezado -->
    <div class="flex items-center justify-between mb-2">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Historial Académico</h1>
            <p class="text-gray-500 mt-1 text-sm">
                Estudiante: <span class="font-semibold text-green-700">{{username}}</span>
            </p>
        </div>
        <a href="/dashboard"
           class="inline-block bg-gray-200 text-gray-700 py-2 px-5 rounded-full font-medium hover:bg-gray-300 transition duration-300 shadow">
            ← Volver al Panel
        </a>
    </div>

    <hr class="my-6 border-green-100">

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
        ✗ {{errorMessage}}
    </div>
    {{/errorMessage}}

    {{^grades}}
    <div class="bg-green-50 border border-green-200 p-8 rounded-lg text-center shadow-sm">
        <p class="text-green-700 font-medium text-lg">Todavía no tenés notas registradas.</p>
        <p class="text-gray-400 text-sm mt-1">Las notas aparecerán aquí cuando tu profesor las cargue.</p>
    </div>
    {{/grades}}

    {{#grades}}
    {{#first}}
    <div class="overflow-x-auto rounded-lg shadow-md border border-green-200">
        <table class="min-w-full text-sm text-gray-700">
            <thead>
                <tr class="bg-green-600 text-white text-left">
                    <th class="py-3 px-4 font-semibold">Materia</th>
                    <th class="py-3 px-4 font-semibold">Código</th>
                    <th class="py-3 px-4 font-semibold">Profesor</th>
                    <th class="py-3 px-4 font-semibold text-center">Nota</th>
                    <th class="py-3 px-4 font-semibold">Observación</th>
                    <th class="py-3 px-4 font-semibold">Fecha</th>
                </tr>
            </thead>
            <tbody>
    {{/first}}
                <tr class="border-b border-green-100 hover:bg-green-50 transition duration-150">
                    <td class="py-3 px-4 font-medium">{{subjectName}}</td>
                    <td class="py-3 px-4 font-mono text-green-700">{{subjectCode}}</td>
                    <td class="py-3 px-4">{{professorName}} {{professorSurname}}</td>
                    <td class="py-3 px-4 text-center">
                        <span class="font-bold text-lg {{#approved}}text-green-600{{/approved}}{{^approved}}text-red-500{{/approved}}">
                            {{grade}}
                        </span>
                        <span class="block text-xs {{#approved}}text-green-500{{/approved}}{{^approved}}text-red-400{{/approved}}">
                            {{#approved}}Aprobado{{/approved}}{{^approved}}Desaprobado{{/approved}}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-gray-500 italic">{{description}}</td>
                    <td class="py-3 px-4 text-gray-400">{{date}}</td>
                </tr>
    {{#last}}
            </tbody>
        </table>
    </div>
    {{/last}}
    {{/grades}}

    <div class="flex justify-end mt-8">
        <a href="/logout"
           class="inline-block bg-red-600 text-white py-2 px-6 rounded-full font-medium hover:bg-red-700 transition duration-300 shadow-md">
            Cerrar Sesión
        </a>
    </div>

</div>
</body>
</html>
